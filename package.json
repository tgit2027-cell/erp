{
  "name": "tivoli-erp-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic Milestone 1 React and TypeScript prototype",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test:contrast": "node scripts/contrast-regression.mjs",
    "test:dev-files": "node --test --test-concurrency=1 scripts/dev-private-files.test.mjs",
    "test:navigation-safety-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/navigation-safety-ui.test.tsx",
    "test:purchasing-ui": "node --test scripts/purchasing-workbench-state.test.mjs && npm run test:purchasing-quote-lines && npm run test:purchasing-context-ui && npm run test:purchasing-transaction-ui && npm run test:sales-return-ui",
    "test:purchasing-quote-lines": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/purchasing-quote-lines.test.ts scripts/purchasing-quote-lines-ui.test.tsx",
    "test:sales-return-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/sales-return-ui.test.tsx",
    "test:delivery-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/delivery-workbench-ui.test.tsx scripts/delivery-preparation-ui.test.tsx",
    "test:retail-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/retail-workbench-ui.test.tsx",
    "test:retail-invoices-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/retail-invoices-ui.test.tsx",
    "test:scenario-reconciliation-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/scenario-reconciliation-ui.test.tsx",
    "test:audit-log-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/audit-log-ui.test.tsx",
    "test:retail-collections-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/retail-collections-ui.test.tsx",
    "test:purchasing-transaction-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/purchasing-transaction-context-ui.test.tsx",
    "test:purchasing-context-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/purchasing-receipt-context-ui.test.tsx scripts/purchasing-quote-context-ui.test.tsx scripts/purchasing-governance-context-ui.test.tsx scripts/purchasing-counterparty-context-ui.test.tsx",
