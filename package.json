    "test:inventory-workspace-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/inventory-workspace-ui.test.tsx scripts/inventory-register-recovery-ui.test.tsx",
    "test:procurement-workspace-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/procurement-workspace-ui.test.tsx",
    "test:procurement-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/procurement-workspace-ui.test.tsx scripts/packing-list-preview-ui.test.tsx scripts/packing-receipt-preparation-ui.test.tsx",
    "test:warehouse-capacity-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/warehouse-capacity-ui.test.tsx scripts/warehouse-capacity-recovery-ui.test.tsx",
    "test:purchase-currency-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/purchase-currency-ui.test.tsx",
    "test:stock-transfer-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/stock-transfer-requests-ui.test.tsx scripts/transfer-permissions-ui.test.tsx",
    "test:supplier-kyc-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/supplier-kyc-ui.test.tsx",
    "test:warehouse-capacity-audit-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/warehouse-capacity-audit-ui.test.tsx",
    "test:governance-workspace-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/governance-workspace-ui.test.tsx",
    "test:packing-list-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/packing-list-parser.test.mjs scripts/packing-list-preview-ui.test.tsx scripts/packing-receipt-preparation-ui.test.tsx",
    "test:sidebar-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/sidebar-navigation-ui.test.tsx scripts/function-navigation-ui.test.tsx",
    "test:sidebar-browser": "npm run build && node --test --test-concurrency=1 scripts/sidebar-browser.test.mjs",
    "test:sales-return-browser": "npm run build && node --test --test-concurrency=1 scripts/sales-return-browser.test.mjs",
    "test:finance-reconciliation-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-reconciliation-ui.test.tsx",
    "test:finance-expense-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-expense-ui.test.tsx",
    "test:finance-asset-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-asset-ui.test.tsx",
    "test:finance-forecast-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-forecast-ui.test.tsx",
    "test:finance-invoice-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-invoice-ui.test.tsx",
    "test:finance-customer-invoice-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-customer-invoice-ui.test.tsx",
    "test:finance-adjustment-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-adjustment-ui.test.tsx",
    "test:finance-customer-credit-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-customer-credit-ui.test.tsx",
    "test:finance-supplier-advance-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-supplier-advance-ui.test.tsx",
    "test:finance-reversal-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-reversal-ui.test.tsx",
    "test:finance-editor-loader-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-editor-loader-ui.test.tsx",
    "test:finance-lab-review-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-lab-review-ui.test.tsx",
    "test:finance-recovery-ui": "node --import tsx --test src/finance-lab-recovery.test.ts",
    "pretest": "npm run test:finance-recovery-ui && npm run test:finance-lab-review-ui && npm run test:finance-reversal-ui && npm run test:finance-editor-loader-ui",
    "test": "npm run test:purchasing-ui && npm run test:supplier-kyc-ui && npm run test:delivery-ui && npm run test:retail-ui && npm run test:retail-collections-ui && npm run test:retail-invoices-ui && npm run test:scenario-reconciliation-ui && npm run test:audit-log-ui && npm run test:reporting-ui && npm run test:finance-draft-ui && npm run test:finance-draft-lab-ui && npm run test:finance-allocation-ui && npm run test:finance-budget-ui && npm run test:finance-reconciliation-ui && npm run test:finance-expense-ui && npm run test:finance-asset-ui && npm run test:finance-forecast-ui && npm run test:finance-invoice-ui && npm run test:finance-customer-invoice-ui && npm run test:finance-adjustment-ui && npm run test:finance-customer-credit-ui && npm run test:finance-supplier-advance-ui && npm run test:favorites-ui && npm run test:overview-ui && npm run test:stock-ui && npm run test:inventory-workspace-ui && npm run test:procurement-workspace-ui && npm run test:packing-list-ui && npm run test:warehouse-capacity-ui && npm run test:warehouse-capacity-audit-ui && npm run test:governance-workspace-ui && npm run test:sidebar-ui && npm run test:navigation-safety-ui && npm run test:dev-files"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  }
