    "test:finance-draft-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/finance-draft-ui.test.tsx",
    "build:finance-draft": "vite build --config vite.finance-draft.config.ts",
    "preview:finance-draft": "vite preview --config vite.finance-draft.config.ts",
    "test:finance-draft-browser": "node --test --test-concurrency=1 scripts/finance-draft-browser.test.mjs",
    "test:finance-draft-lab-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/finance-draft-lab-ui.test.tsx",
    "test:finance-allocation-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/finance-allocation-ui.test.tsx",
    "test:finance-budget-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test src/finance-budget-ui.test.tsx",
    "test:finance-draft-real": "bash scripts/verify-finance-draft-workflow.sh",
    "test:favorites-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/purchasing-favorites-ui.test.tsx",
    "test:overview-ui": "node --import tsx --import ./scripts/ui-test-register.mjs --test scripts/overview-location-tree-ui.test.tsx",
