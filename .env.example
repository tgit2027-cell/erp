# Demo-only settings. Copy to .env for local development; never put secrets here.
APP_ENV=demo
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# The Replit runner supplies the exact HTTPS preview host and port itself.
# For a local Vite preview, use only the local origins:
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
DB_NAME=tivoli_erp_demo
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=55432
